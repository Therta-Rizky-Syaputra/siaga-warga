# Contoh isi .env untuk VPS (JANGAN commit berkas .env yang asli)
APP_NAME="Siaga Warga"
APP_ENV=production
APP_KEY=            # hasilkan dengan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://siaga.contoh.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=error

# SQLite cukup untuk satu RT (ratusan laporan). Naik ke MySQL/MariaDB bila > 5.000 laporan.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/siaga-warga/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=20160          # 14 hari: warga tidak perlu login ulang terus
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true      # hanya kirim cookie lewat HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# laporan penting (laporan baru, keluhan) dikirim lewat antrean, bukan di depan warga
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
CACHE_STORE=database
MAIL_MAILER=log
