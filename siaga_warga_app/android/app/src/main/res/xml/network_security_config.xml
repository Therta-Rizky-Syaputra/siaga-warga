<?xml version="1.0" encoding="utf-8"?>
<!--
  Warga mengakses server RT/RW. Bila server sudah HTTPS, seluruh lalu lintas wajib
  terenkripsi. Pengecualian hanya untuk server uji di jaringan lokal (alamat 10.x / 192.168.x),
  supaya pengurus bisa mencoba lewat WiFi rumah tanpa sertifikat.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
